# VaaniX embedding / Qdrant configuration. Copy to .env — never commit secrets.

# intfloat/multilingual-e5-small (384-d). Uses prefixes:
#   queries   -> "query: {text}"
#   documents -> "passage: {text}"
VAANIX_EMBEDDING_MODEL=intfloat/multilingual-e5-small
VAANIX_EMBEDDING_DEVICE=auto
VAANIX_EMBEDDING_BATCH_SIZE=32
VAANIX_EMBEDDING_NORMALIZE=true
VAANIX_EMBEDDING_QUERY_PREFIX=query: 
VAANIX_EMBEDDING_DOC_PREFIX=passage: 
VAANIX_EMBEDDING_CACHE=true
VAANIX_EMBEDDING_CACHE_DIR=data/cache/embeddings

# Local embedded Qdrant (default). Leave URL empty for local path.
VAANIX_QDRANT_PATH=data/indexes/qdrant
VAANIX_QDRANT_URL=
VAANIX_QDRANT_API_KEY=
VAANIX_QDRANT_COLLECTION=vaanix_chunks
VAANIX_QDRANT_DISTANCE=Cosine
VAANIX_QDRANT_UPSERT_BATCH=64

VAANIX_VECTOR_TOP_K=10
# Cap passages indexed in dev. 0 = no cap (full jsonl).
VAANIX_VECTOR_INDEX_SAMPLE_SIZE=200

# Hybrid / BM25 / RRF
VAANIX_RRF_K=60
VAANIX_HYBRID_CANDIDATE_K=20
VAANIX_HYBRID_PARALLEL=true
VAANIX_BM25_K1=1.5
VAANIX_BM25_B=0.75
VAANIX_BM25_INDEX_PATH=data/indexes/bm25.pkl

# LLM (OpenAI-compatible). Never commit real keys.
VAANIX_LLM_API_KEY=
OPENAI_API_KEY=
VAANIX_LLM_BASE_URL=https://api.openai.com/v1
VAANIX_LLM_MODEL=gpt-4o-mini
VAANIX_LLM_TIMEOUT_S=30
VAANIX_LLM_RETRIES=2
VAANIX_MAX_EVIDENCE_CHUNKS=5
VAANIX_MAX_CONTEXT_CHARS=3500
VAANIX_MIN_RRF_SCORE=0.012
VAANIX_MIN_QUERY_OVERLAP=0.04
VAANIX_VERIFY_TOKEN_OVERLAP=0.12
VAANIX_REGENERATE_ON_FAIL=true

# Query routing (FAST / ACCURATE / DEEP). No LLM classifier.
VAANIX_ROUTE_FAST_MAX_TOKENS=12
VAANIX_ROUTE_FAST_MAX_CHARS=90
VAANIX_ROUTE_FAST_MAX_CLAUSES=1
VAANIX_ROUTE_ACCURATE_MAX_TOKENS=28
VAANIX_ROUTE_DEEP_MIN_TOKENS=22
VAANIX_ROUTE_DEEP_MIN_CLAUSES=3
VAANIX_ROUTE_FAST_TOP_K=8
VAANIX_ROUTE_ACCURATE_TOP_K=10
VAANIX_ROUTE_DEEP_TOP_K=10
VAANIX_ROUTE_FAST_CANDIDATE_K=16
VAANIX_ROUTE_ACCURATE_CANDIDATE_K=20
VAANIX_ROUTE_DEEP_CANDIDATE_K=40
VAANIX_DEEP_VERIFY_TOKEN_OVERLAP=0.18

# Rerank top-N hybrid hits only. Backend: auto | cross_encoder | lexical
VAANIX_RERANK_TOP_N=12
VAANIX_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
VAANIX_RERANKER_BACKEND=auto
VAANIX_RERANKER_BATCH_SIZE=16
VAANIX_RERANKER_DEVICE=auto

# Skip rerank when hybrid is already confident
VAANIX_RERANK_MIN_TOP_RRF=0.028
VAANIX_RERANK_MIN_SCORE_GAP=0.006
VAANIX_RERANK_STRONG_RRF=0.018
VAANIX_RERANK_MAX_STRONG=2
VAANIX_RERANK_DEEP_SKIP_MIN_RRF=0.040
VAANIX_RERANK_ALLOW_FAST=false

# API
VAANIX_CORS_ORIGINS=*
VAANIX_SKIP_WARMUP=false

# Sarvam STT (https://api.sarvam.ai/speech-to-text). Never commit the key.
SARVAM_API_KEY=
VAANIX_SARVAM_API_KEY=
VAANIX_SARVAM_STT_MODEL=saaras:v3
VAANIX_SARVAM_STT_MODE=transcribe
VAANIX_SARVAM_TIMEOUT_S=45
