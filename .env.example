# VaaniX embedding / Qdrant configuration. Copy to .env — never commit secrets.

# intfloat/multilingual-e5-small (384-d). Uses prefixes:
#   queries   -> "query: {text}"
#   documents -> "passage: {text}"
VAANIX_EMBEDDING_MODEL=intfloat/multilingual-e5-small
VAANIX_EMBEDDING_DEVICE=auto
VAANIX_EMBEDDING_BATCH_SIZE=32
VAANIX_EMBEDDING_NORMALIZE=true
VAANIX_EMBEDDING_QUERY_PREFIX=query: 
VAANIX_EMBEDDING_DOC_PREFIX=passage: 
VAANIX_EMBEDDING_CACHE=true
VAANIX_EMBEDDING_CACHE_DIR=data/cache/embeddings

# Local embedded Qdrant (default). Leave URL empty for local path.
VAANIX_QDRANT_PATH=data/indexes/qdrant
VAANIX_QDRANT_URL=
VAANIX_QDRANT_API_KEY=
VAANIX_QDRANT_COLLECTION=vaanix_chunks
VAANIX_QDRANT_DISTANCE=Cosine
VAANIX_QDRANT_UPSERT_BATCH=64

VAANIX_VECTOR_TOP_K=10
# Cap passages indexed in dev. 0 = no cap (full jsonl).
VAANIX_VECTOR_INDEX_SAMPLE_SIZE=200
